# AI API Keys
# OpenAI API Key - Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Google Gemini API Key - Get from: https://makersuite.google.com/app/apikey
# Or from: https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key-here

# Choose which AI provider to use: "openai" or "gemini"
# Default is "openai"
AI_PROVIDER=openai

# ElevenLabs API Key - Get from: https://elevenlabs.io/app/speech-synthesis
# For ultra-realistic, human-like voice synthesis (HIGHLY RECOMMENDED)
# Get 10,000 free characters per month
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here

# Google Calendar URL for meeting scheduling
# Replace with your Google Calendar booking link
NEXT_PUBLIC_CALENDAR_URL=https://calendar.app.google/your-link-here

# Brand Colors - Symmetri Growth
NEXT_PUBLIC_PRIMARY_COLOR=#E87105
NEXT_PUBLIC_SECONDARY_COLOR=#F89F05
NEXT_PUBLIC_ACCENT_COLOR=#FFBA00
NEXT_PUBLIC_WIDGET_POSITION=bottom-right
