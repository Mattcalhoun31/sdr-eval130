# AI API Keys
# OpenAI API Key - Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Google Gemini API Key - Get from: https://makersuite.google.com/app/apikey
# Or from: https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key-here

# Choose which AI provider to use: "openai" or "gemini"
# Default is "openai"
AI_PROVIDER=openai

# Optional: Calendly URL for meeting scheduling
# Replace with your Calendly booking link
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-username/meeting

# Optional: Custom configuration
NEXT_PUBLIC_WIDGET_POSITION=bottom-right
NEXT_PUBLIC_PRIMARY_COLOR=#3b82f6
